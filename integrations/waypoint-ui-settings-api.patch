diff --git a/API.lua b/API.lua
index cbacd32..f93783d 100644
--- a/API.lua
+++ b/API.lua
@@ -50,3 +50,171 @@ do -- @\\Settings
     WaypointUIAPI_OpenSettingsUI = Setting.OpenSettingsUI
     WaypointUIAPI.OpenSettingsUI = Setting.OpenSettingsUI
 end
+
+
+-- Optional public preference API, version 1. Only explicitly listed scalar
+-- preferences are exposed. The settings schema remains the source of truth.
+do
+    local Config = env.Config
+    local SavedVariables = env.modules:Import("packages\\saved-variables")
+    local CallbackRegistry = env.modules:Import("packages\\callback-registry")
+    local Schema = env.modules:Await("@\\Settings\\Schema")
+    local WidgetType = env.modules:Import("@\\Settings\\Enum").WidgetType
+    local allow = {
+        WaypointSystemType = true,
+        AlwaysShow = true,
+        RightClickToClear = true,
+        BackgroundPreview = true,
+        DistanceThresholdPinpoint = true,
+        DistanceThresholdHidden = true,
+        WaypointDistanceTextType = true,
+        PinpointInfo = true,
+        PinpointInfoExtended = true,
+        PinpointAllowInQuestArea = true,
+        NavigatorShow = true,
+        ContextIconAppearance = true,
+        WaypointScale = true,
+        WaypointUseWorldScale = true,
+        WaypointScaleMin = true,
+        WaypointScaleMax = true,
+        WaypointAlpha = true,
+        WaypointBeam = true,
+        WaypointBeamAlpha = true,
+        WaypointDistanceTextFontFlags = true,
+        WaypointDistanceText = true,
+        WaypointDistanceTextScale = true,
+        WaypointDistanceTextAlpha = true,
+        WaypointDistanceSubtextAlpha = true,
+        PinpointScale = true,
+        PinpointAlpha = true,
+        PinpointShowContextIcon = true,
+        PinpointFontFlags = true,
+        PinpointTextAlignment = true,
+        NavigatorShowContextIcon = true,
+        NavigatorShowArrow = true,
+        NavigatorScale = true,
+        NavigatorArrowScale = true,
+        NavigatorAlpha = true,
+        NavigatorDistance = true,
+        NavigatorDynamicDistance = true,
+        CustomMapPinsEnabled = true,
+        AutoTrackPlacedPinEnabled = true,
+        AutoTrackChatLinkPinEnabled = true,
+        GuidePinAssistantEnabled = true,
+        AudioGlobal = true,
+        AudioProximity = true,
+        AudioProximityDistance = true,
+        AudioProximitySound = true,
+        AudioProximityLeavingDistance = true,
+        AudioProximityLeavingSound = true,
+        AudioCustom = true,
+        AudioCustomShowWaypoint = true,
+        AudioCustomShowPinpoint = true,
+        AudioCustomNewUserNavigation = true,
+        PrefMetric = true,
+    }
+    local entries, listeners = {}, {}
+    local function resolve(value)
+        if type(value) == "function" then return value() end
+        return value
+    end
+    local function visit(nodes, parents)
+        for _, node in ipairs(nodes) do
+            local path = {}
+            for i, parent in ipairs(parents) do path[i] = parent end
+            path[#path + 1] = node
+            if allow[node.key] then entries[node.key] = { node = node, path = path } end
+            if node.children then visit(node.children, path) end
+        end
+    end
+    visit(Schema.SCHEMA, {})
+    local API = { version = 1 }
+    local function finite(value)
+        return type(value) == "number" and value == value and math.abs(value) ~= math.huge
+    end
+    local function available(key)
+        return type(key) == "string" and allow[key] and entries[key] and Config.DBGlobal
+    end
+    function API.Get(key)
+        if not available(key) then return nil, "Unsupported setting or database not ready" end
+        return Config.DBGlobal:GetVariable(key)
+    end
+    function API.IsExplicit(key)
+        if not available(key) then return nil, "Unsupported setting or database not ready" end
+        -- Defaults are fallback values, not materialized in the saved table.
+        return type(WaypointDB_Global) == "table" and rawget(WaypointDB_Global, key) ~= nil
+    end
+    function API.Describe(key)
+        if not available(key) then return nil, "Unsupported setting or database not ready" end
+        local entry, result = entries[key], { visible = true, enabled = true }
+        local node = entry.node
+        result.default = Config.DBGlobal.defaultValues[key]
+        for _, parent in ipairs(entry.path) do
+            if parent.showWhen and not parent.showWhen() then result.visible = false end
+            if parent.disableWhen and parent.disableWhen() then result.enabled = false end
+        end
+        if node.widgetType == WidgetType.CheckButton then result.type = "boolean"
+        elseif node.widgetType == WidgetType.Range then
+            result.type = "number"
+            result.min = resolve(node.widgetRange_min)
+            result.max = resolve(node.widgetRange_max)
+            result.step = resolve(node.widgetRange_step)
+        elseif node.widgetType == WidgetType.SelectionMenu then
+            result.type, result.options = "select", {}
+            for index, label in ipairs(resolve(node.widgetSelectionMenu_data)) do
+                result.options[index] = { value = index, label = label }
+            end
+        elseif node.widgetType == WidgetType.Input and key:match("^Audio") then result.type = "sound"
+        else return nil, "Unsupported control type" end
+        return result
+    end
+    function API.Format(key, value)
+        if not available(key) then return nil end
+        local node = entries[key].node
+        if node.widgetRange_textFormattingFunc then return tostring(node.widgetRange_textFormattingFunc(value)) end
+        if node.widgetRange_textFormatting then return string.format(node.widgetRange_textFormatting, tostring(value)) end
+        return tostring(value)
+    end
+    function API.Set(key, value)
+        local d, reason = API.Describe(key)
+        if not d then return false, reason end
+        local valid = d.type == "boolean" and type(value) == "boolean"
+        if d.type == "number" then
+            valid = finite(value) and value >= d.min and value <= d.max
+            if valid then
+                local steps = (value - d.min) / d.step
+                valid = math.abs(steps - math.floor(steps + 0.5)) < 0.00001 or value == d.max
+            end
+        elseif d.type == "select" then
+            valid = finite(value) and value == math.floor(value) and d.options[value] ~= nil
+        elseif d.type == "sound" then
+            valid = value == "" or (finite(value) and value >= 0 and value == math.floor(value))
+        end
+        if not valid then return false, "Invalid preference value" end
+        if API.Get(key) == value then return true end
+        Config.DBGlobal:SetVariable(key, value)
+        -- This is the same UI invalidation used by Waypoint UI's own controls.
+        CallbackRegistry.Trigger("Setting.Refresh", true)
+        return true
+    end
+    function API.OnChange(key, callback)
+        if (key ~= "*" and not available(key)) or type(callback) ~= "function" then
+            return nil, "Unsupported subscription"
+        end
+        local token = { key = key, callback = callback }
+        listeners[token] = true
+        return function() listeners[token] = nil end
+    end
+    for key in pairs(entries) do
+        local settingKey = key
+        SavedVariables.OnChange("WaypointDB_Global", settingKey, function(_, value)
+            -- Read effective state; registry arguments are intentionally not part of this API.
+            for token in pairs(listeners) do
+                if token.key == "*" or token.key == settingKey then
+                    pcall(token.callback, settingKey, API.Get(settingKey))
+                end
+            end
+        end)
+    end
+    WaypointUIAPI.Settings = API
+end
